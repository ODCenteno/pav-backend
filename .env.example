HOST=0.0.0.0
PORT=1337

# Frontend URL (for CORS)
FRONTEND_URL=https://guiacomunidadesloretanas.com

# Strapi server URL (public URL of this Strapi instance)
# Production: https://admin.guiacomunidadesloretanas.com
URL=http://localhost:1337
STRAPI_URL=http://localhost:1337

# Admin panel URL (config/admin.ts + CORS). Production:
# ADMIN_URL=https://admin.guiacomunidadesloretanas.com
ADMIN_URL=http://localhost:1337

# Set to true when running behind a reverse proxy / load balancer (Koyeb, Cloudflare, etc.)
# IS_BEHIND_PROXY=false

# Production hardening — disable Strapi admin telemetry, NPS prompts, and EE promos.
# STRAPI_TELEMETRY_DISABLED is also set in Dockerfile; set here for local parity.
# In Koyeb, set FLAG_NPS=false and FLAG_PROMOTE_EE=false to silence admin UI prompts.
STRAPI_TELEMETRY_DISABLED=true
FLAG_NPS=false
FLAG_PROMOTE_EE=false

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
# users-permissions plugin secret (config/plugins.ts). Falls back to ADMIN_JWT_SECRET
# when unset — set a dedicated one in production.
USERS_PERMISSIONS_JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development (SQLite)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production (PostgreSQL, e.g. Neon) — switch DATABASE_CLIENT to "postgres".
# DATABASE_URL takes precedence; the individual fields are the fallback.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SCHEMA=public
DATABASE_SSL=false

# Google Maps API (admin panel map picker)
# Get this from Google Cloud Console → APIs & Services → Credentials → Create Credentials → API Key
# Restrict the key to HTTP referrers = your admin domain in production
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloudflare R2 (media storage)
# Get these from the Cloudflare dashboard → R2 → Manage API Tokens
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-access-key-id>
R2_SECRET_ACCESS_KEY=<your-secret-access-key>
R2_BUCKET=pav-assets
# The public-facing URL for your R2 bucket (R2.dev public URL or a custom domain)
R2_PUBLIC_BASE_URL=https://<your-r2-public-base-url>
# Optional: Cloudflare API token (only needed if using R2 Worker scripts)
# R2_TOKEN_PAV=<your-cloudflare-api-token>