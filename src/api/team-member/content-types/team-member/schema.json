{
  "kind": "collectionType",
  "collectionName": "team_members",
  "info": {
    "singularName": "team-member",
    "pluralName": "team-members",
    "displayName": "Miembro del Equipo",
    "description": "Personas detrás del proyecto."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "description": "Nombre completo de la persona."
    },
    "role": {
      "type": "component",
      "repeatable": false,
      "component": "common.localized-text",
      "description": "Cargo o rol de la persona dentro del proyecto."
    },
    "shortBio": {
      "type": "component",
      "repeatable": false,
      "component": "common.localized-text",
      "description": "Biografía breve en español e inglés."
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Fotografía de la persona."
    },
    "links": {
      "type": "component",
      "repeatable": false,
      "component": "contact.links",
      "description": "Enlaces y redes sociales de la persona."
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "Orden de aparición. Los números menores aparecen primero."
    },
    "isFeatured": {
      "type": "boolean",
      "default": true,
      "description": "Marca esta casilla para destacar a la persona en la página."
    }
  }
}