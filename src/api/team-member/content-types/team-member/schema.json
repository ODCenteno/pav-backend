    },
    "role": {
      "type": "json"
    },
    "shortBio": {
      "type": "json"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "links": {
      "type": "json"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "isFeatured": {
      "type": "boolean",
      "default": true
    }
  }
}
