{
  "kind": "collectionType",
  "collectionName": "organizations",
  "info": {
    "singularName": "organization",
    "pluralName": "organizations",
    "displayName": "Organización",
    "description": "Organizaciones locales y aliados del proyecto."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "description": "Nombre oficial de la organización."
    },
    "type": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "community",
      "enum": [
        "community",
        "institution",
        "partner",
        "collective",
        "business"
      ],
      "description": "Tipo de organización: comunidad, institución, aliado, colectivo o negocio."
    },
    "shortDescription": {
      "type": "component",
      "repeatable": false,
      "component": "common.localized-text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Descripción breve de la organización en español e inglés."
    },
    "logo": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Logotipo oficial de la organización."
    },
    "links": {
      "type": "component",
      "repeatable": false,
      "component": "contact.links",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "description": "Enlaces y redes sociales de la organización."
    },
    "order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": 0,
      "description": "Orden de aparición. Los números menores aparecen primero."
    },
    "isFeatured": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": true,
      "description": "Marca esta casilla para destacar la organización en la página."
    }
  }
}